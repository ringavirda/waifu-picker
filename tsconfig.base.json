{
  "compilerOptions": {
    "target": "esnext",
    "moduleDetection": "auto",
    "esModuleInterop": true,
    "sourceMap": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
