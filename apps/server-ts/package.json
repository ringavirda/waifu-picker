{
  "name": "@wp/server",
  "version": "1.0.0",
  "scripts": {
    "clear": "rimraf dist && mkdirp dist",
    "format": "prettier src/** --write --log-level silent",
    "lint": "eslint src/** --fix",
    "build": "webpack --config configs/webpack.dev.cjs",
    "build-prod": "webpack --config configs/webpack.prod.cjs",
    "build-watch": "webpack --config configs/webpack.dev.cjs --watch",
    "start": "node dist/main.bundle.js",
    "serve": "node --watch dist/main.bundle.js"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@wp/common": "workspace:^",
    "@wp/controllers": "workspace:^",
    "babel-loader": "^10.0.0",
    "chalk": "^5.6.2",
    "copy-webpack-plugin": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-loader": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-object-assign": "^7.27.1",
    "@eslint/js": "^9.39.1",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/cors": "^2",
    "@types/express": "^5.0.0",
    "@types/file-loader": "~5.0.4",
    "@types/node": "^24.10.0",
    "@types/reflect-metadata": "^0.1.0",
    "@types/webpack-node-externals": "~3.0.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "file-loader": "^6.2.0",
    "prettier": "^3.6.2",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
