{
  "name": "@wp/client-react",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write --log-level silent",
    "lint": "eslint . --fix",
    "serve": "vite --config ./configs/vite.config.ts",
    "build": "tsc -b && vite build --config ./configs/vite.config.ts",
    "build:prod": "tsc -b && vite build --mode prod --config ./configs/vite.config.ts",
    "build:full": "yarn format && yarn lint && yarn build:prod",
    "preview": "vite preview --config ./configs/vite.config.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.10.1",
    "@tailwindcss/vite": "^4.1.17",
    "@wp/common": "workspace:^",
    "inversify": "^7.10.4",
    "observable-hooks": "^4.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.6",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.22.5",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-parameter-decorator": "^1.0.16",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
